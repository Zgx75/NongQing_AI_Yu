{
  "name": "nong-qing-ai-yu",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "node scripts/prepare-postgres-schema.mjs && prisma generate --schema prisma/schema.postgresql.generated.prisma && next build",
    "start": "next start",
    "lint": "eslint src tests prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:prepare:postgres": "node scripts/prepare-postgres-schema.mjs",
    "db:push:postgres": "node scripts/prepare-postgres-schema.mjs && prisma db push --schema prisma/schema.postgresql.generated.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:production": "tsx prisma/seed-production.ts",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "evidence:add-source": "tsx scripts/add-trusted-source.ts",
    "evidence:build-pdf-index": "node scripts/build-official-pdf-index.mjs"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "pnpm": { "overrides": { "sharp": "0.35.0", "postcss": "8.5.18" } },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1096.0",
    "@vercel/blob": "2.6.1",
    "@prisma/client": "6.10.1",
    "bcryptjs": "3.0.2",
    "clsx": "2.1.1",
    "jose": "6.0.11",
    "lucide-react": "0.468.0",
    "next": "15.5.21",
    "pdf-lib": "1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "2.6.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@eslint/eslintrc": "3.3.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.15.32",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "9.29.0",
    "eslint-config-next": "15.5.21",
    "jsdom": "26.1.0",
    "pdfjs-dist": "6.3.289",
    "prisma": "6.10.1",
    "tailwindcss": "4.1.10",
    "@tailwindcss/postcss": "4.1.10",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
